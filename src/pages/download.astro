---
import Base from '../layouts/Base.astro'
import { APP_REPO_URL, RELEASES_URL } from '../lib/site'
import { snapshotRelease } from '../lib/snapshot'
import { releasePanel } from '../lib/views'

const release = snapshotRelease
const appImage = release?.assets.find((asset) => asset.kind === 'appimage')?.name ?? 'ostia-<version>.AppImage'
const tarball =
  release?.assets.find((asset) => asset.kind === 'tarball')?.name ?? 'ostia-<version>-linux-x64.tar.gz'
const folder = tarball.replace(/\.tar\.gz$/, '')
---

<Base
  title="Download Ostia for Linux"
  description="Get the latest Ostia release for Linux as an AppImage or a tarball, with install steps and how updates work."
  current="download"
>
  <section class="wrap pb-10 pt-12 md:pt-16" aria-labelledby="title">
    <h1 id="title" class="display">Download Ostia</h1>
    <p class="lede mt-5 max-w-[60ch]">
      Ostia has Linux builds today, for x64. macOS and Windows builds are not published yet.
    </p>
  </section>

  <section class="wrap pb-16" aria-labelledby="latest">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-14">
      <div>
        <h2 id="latest" class="title">Latest release</h2>
        <div id="release" class="mt-4" aria-live="polite">
          {
            release ? (
              <Fragment set:html={releasePanel(release).value} />
            ) : (
              <p class="text-muted-foreground">The latest release is listed on GitHub.</p>
            )
          }
        </div>
        <p id="release-status" class="mt-4 text-sm text-muted-foreground" role="status">
          {release ? 'This is the latest release known when this page was built.' : ''}
        </p>
        <p class="mt-2 text-sm">
          <a class="link" href={RELEASES_URL} rel="noopener">All releases on GitHub</a>
        </p>
      </div>
      <aside class="lg:pt-12" aria-labelledby="updates">
        <h2 id="updates" class="text-lg font-medium">How updates work</h2>
        <p class="mt-3 leading-relaxed text-muted-foreground">
          Ostia asks GitHub for the latest release once a day and shows a notice with a link. It never downloads
          or installs anything by itself. You can switch the check off in Settings, under About.
        </p>
      </aside>
    </div>
  </section>

  <section class="border-t bg-card py-16" aria-labelledby="install">
    <div class="wrap">
      <h2 id="install" class="title">Install</h2>
      <div class="mt-8 grid grid-cols-1 gap-10 lg:grid-cols-2 lg:gap-14">
        <div>
          <h3 class="text-lg font-medium">AppImage</h3>
          <p class="mt-2 leading-relaxed text-muted-foreground">Make the file executable, then run it.</p>
          <pre class="codeblock mt-4 !bg-background" tabindex="0" aria-label="AppImage commands"><code>chmod +x <span data-file="appimage">{appImage}</span>
./<span data-file="appimage">{appImage}</span></code></pre>
        </div>
        <div>
          <h3 class="text-lg font-medium">Tarball</h3>
          <p class="mt-2 leading-relaxed text-muted-foreground">Unpack the app folder anywhere, then run <code>pine</code> inside it.</p>
          <pre class="codeblock mt-4 !bg-background" tabindex="0" aria-label="Tarball commands"><code>tar -xzf <span data-file="tarball">{tarball}</span>
./<span data-file="folder">{folder}</span>/pine</code></pre>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap py-16" aria-labelledby="source">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-14">
      <div>
        <h2 id="source" class="title">Build from source</h2>
        <p class="mt-3 max-w-[52ch] leading-relaxed text-muted-foreground">
          With Node.js and pnpm, the <a class="link" href={APP_REPO_URL} rel="noopener">repository</a> packages
          and installs the app for your user. Run the same commands again to update.
        </p>
        <pre class="codeblock mt-4" tabindex="0" aria-label="Build commands"><code>git clone {APP_REPO_URL}.git
cd ostia
pnpm install
pnpm install:local</code></pre>
      </div>
      <div>
        <h3 class="text-lg font-medium">What that install puts on your machine</h3>
        <ul class="prose-list mt-3 list-disc pl-5 leading-relaxed text-muted-foreground">
          <li>The app in <code>~/.local/share/pine/app</code></li>
          <li>A desktop launcher in <code>~/.local/share/applications/pine.desktop</code>, with its icons</li>
          <li>
            The <code>pine</code> command in <code>~/.local/bin</code>, for use outside the app. Inside Ostia
            every pane already has it.
          </li>
        </ul>
      </div>
    </div>
  </section>
</Base>

<script>
  import '../client/download.ts'
</script>
