---
import Icon from '../components/Icon.astro'
import Shot from '../components/Shot.astro'
import { Showcase, type Slide } from '../components/Showcase'
import { buttonVariants } from '../components/ui/button'
import Base from '../layouts/Base.astro'
import { href } from '../lib/paths'
import { formatDate } from '../lib/release'
import { shotSources } from '../lib/shots'
import { APP_REPO_URL, SDK_URL } from '../lib/site'
import { snapshotRelease } from '../lib/snapshot'

const slides: Slide[] = [
  {
    id: 'agents',
    label: 'Run agents',
    caption:
      'Six projects in one window. The sidebar says which agent is working, which is waiting on you and which is done.',
    alt: 'The Pine window. The sidebar lists six projects in two groups with their agent states. In marlow-api an agent has made a change and asks whether to apply a migration, and the diff of its change is open beside it.',
    image: await shotSources('hero'),
  },
  {
    id: 'browser',
    label: 'Drive the browser',
    caption:
      'An agent starts the dev server in a tab, opens the page in a browser pane and clicks through it with the pine command.',
    alt: 'An agent session in marlow-web that ran pine process run, pine browse open, snapshot and click. Beside it a browser pane shows the invoices page the agent opened.',
    image: await shotSources('browser'),
  },
  {
    id: 'review',
    label: 'Review changes',
    caption: 'Changed files and the diff sit beside the shell, for you and for the agent that made them.',
    alt: 'A terminal with git status, the Git panel listing two changed and two untracked files, and the diff of invoices.ts.',
    image: await shotSources('review'),
  },
  {
    id: 'approve',
    label: 'Approve',
    caption: 'A call that needs a permission the pane lacks waits on a card until you answer.',
    alt: 'An agent session paused at pine browse open. A card under the terminal asks to drive the in-app browser, with Deny, Allow for this pane and Allow once.',
    image: await shotSources('approval'),
  },
]

const states = [
  { name: 'Working', shape: 'rounded-full bg-state-working', body: 'The agent is running. Nothing for you to do.' },
  {
    name: 'Waiting',
    shape: 'rounded-full bg-state-waiting',
    body: 'It asked a question or needs a permission. Its pane gets a ring.',
  },
  {
    name: 'Done',
    shape: 'rounded-full bg-state-done',
    body: 'It finished while you were elsewhere. The row keeps an unread count.',
  },
  { name: 'Failed', shape: 'rounded-[2px] bg-state-waiting', body: 'A command exited with an error.' },
]

const commands = [
  { command: 'pine process run', result: 'A tab you can watch' },
  { command: 'pine browse open', result: 'A browser pane the agent drives' },
  { command: 'pine git open', result: 'A diff pane beside the shell' },
  { command: 'pine state waiting', result: 'The ring on the pane and the mark in the sidebar' },
]

const also = [
  {
    title: 'Command blocks',
    body: 'Every command is a block. Select one to copy it, rerun it or send its output to an agent.',
  },
  {
    title: 'Workspaces come back',
    body: 'Layout and scrollback are saved as you work. After a restart each pane returns idle in its folder.',
  },
  {
    title: 'Their own windows',
    body: 'Move a workspace or a single pane to another window. Its shells keep running through the move.',
  },
  {
    title: 'An editor with language servers',
    body: 'Files open in a Monaco editor. Language servers arrive as extensions, per language.',
  },
  {
    title: 'An assistant on a model you pick',
    body: 'Chat, command suggestions and completions through a local or hosted model. Off until you choose one.',
  },
  {
    title: 'Settings sync you own',
    body: 'Mirror settings to a folder you control. Secrets and permission grants never sync.',
  },
]

const release = snapshotRelease
const appImage = release?.assets.find((asset) => asset.kind === 'appimage')?.name ?? 'pine-<version>.AppImage'
---

<Base
  title="Pine: one workspace for you and your coding agents"
  description="Pine is a terminal for Linux where Claude Code, Codex and your own shell share panes, a browser, diffs and approvals."
  current="home"
>
  <section class="wrap pt-14 pb-20 md:pt-20 md:pb-28" aria-labelledby="claim">
    <h1 id="claim" class="display rise max-w-[21ch]">One workspace for you and every coding agent you run.</h1>
    <p class="lede rise mt-5 max-w-[54ch]" style="--rise: 1">
      Pine is a terminal for Linux where Claude Code, Codex and your own shell share panes, a browser, diffs and
      approvals.
    </p>
    <div class="rise mt-8 flex flex-wrap gap-3" style="--rise: 2">
      <a class={buttonVariants({ size: 'xl' })} href={href('download/')}><Icon name="download" /> Download</a>
      <a class={buttonVariants({ size: 'xl', variant: 'outline' })} href={APP_REPO_URL} rel="noopener">
        <Icon name="github" /> Source
      </a>
    </div>
    <div class="rise mt-12 md:mt-16" style="--rise: 3">
      <Showcase client:load slides={slides} />
    </div>
  </section>

  <section class="wrap py-20 md:py-28" aria-labelledby="attention">
    <div class="grid items-center gap-x-16 gap-y-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
      <div>
        <h2 id="attention" class="title">See which agent needs you</h2>
        <p class="lede mt-4 max-w-[46ch]">
          Each pane reports what its agent is doing through the agent's own hooks. The sidebar and the notification
          list show it for every project at once.
        </p>
        <dl class="mt-9 grid gap-5">
          {
            states.map((state) => (
              <div class="grid grid-cols-[1.25rem_minmax(0,1fr)] gap-x-2">
                <span class:list={['mt-[0.45rem] size-2.5', state.shape]} aria-hidden="true" />
                <div>
                  <dt class="font-medium">{state.name}</dt>
                  <dd class="mt-0.5 text-muted-foreground">{state.body}</dd>
                </div>
              </div>
            ))
          }
        </dl>
      </div>
      <figure class="stage reveal grid items-start gap-4 sm:grid-cols-[292fr_336fr] md:gap-5">
        <Shot
          name="rail"
          class="max-sm:mx-auto max-sm:max-w-[292px]"
          sizes="(min-width: 1024px) 300px, (min-width: 640px) 42vw, 292px"
          alt="Pine's sidebar: marlow-api waiting with a question, marlow-web needing approval, marlow-sdk done, harbor-infra working, tidepool with a failed command, handbook idle."
        />
        <Shot
          name="notifications"
          class="max-sm:mx-auto max-sm:max-w-[336px]"
          sizes="(min-width: 1024px) 340px, (min-width: 640px) 48vw, 336px"
          alt="The notification list: a permission request from marlow-web with Deny and Allow once, an agent in marlow-api that needs input, and an agent in marlow-sdk that finished."
        />
      </figure>
    </div>
  </section>

  <section class="wrap py-20 md:py-28" aria-labelledby="cli">
    <h2 id="cli" class="title max-w-[24ch]">What an agent types is what you see</h2>
    <p class="lede mt-4 max-w-[58ch]">
      Every pane has a <code>pine</code> command. It works the same for any agent that can run a shell command, and
      whatever it does happens in the window in front of you.
    </p>
    <figure class="stage reveal pan mt-10">
      <Shot
        name="cli"
        class="max-md:min-w-[46rem]"
        sizes="(min-width: 1296px) 1136px, calc(100vw - 4rem)"
        alt="On the left an agent's session lists the pine commands it ran: process run, browse open, snapshot, click and get text. On the right the browser pane shows the page those commands opened and clicked."
      />
    </figure>
    <dl class="mt-9 grid gap-x-10 gap-y-7 sm:grid-cols-2 lg:grid-cols-4">
      {
        commands.map((item) => (
          <div>
            <dt class="font-mono text-[0.875rem]">{item.command}</dt>
            <dd class="mt-1.5 text-muted-foreground">{item.result}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="wrap py-20 md:py-28" aria-labelledby="control">
    <h2 id="control" class="title">You decide what an agent may do</h2>
    <div class="mt-10 grid gap-x-8 gap-y-14 md:grid-cols-2">
      <figure>
        <div class="stage reveal">
          <Shot
            name="approval-card"
            sizes="(min-width: 768px) 560px, calc(100vw - 4rem)"
            alt="An agent paused at pine browse open. The card reads: wants to drive the in-app browser, with Deny, Allow for this pane and Allow once."
          />
        </div>
        <figcaption class="mt-6 max-w-[48ch]">
          <h3 class="text-lg font-medium">Approval cards</h3>
          <p class="mt-2 text-muted-foreground">
            A call that needs a permission the pane lacks waits on a card: allow once, allow for the pane, or deny.
          </p>
        </figcaption>
      </figure>
      <figure>
        <div class="stage reveal">
          <Shot
            name="sandbox-card"
            sizes="(min-width: 768px) 560px, calc(100vw - 4rem)"
            alt="A sandboxed shell. Reading an SSH key fails, and a request to api.stripe.com waits on a card with Deny, Allow until restart and Allow for this workspace."
          />
        </div>
        <figcaption class="mt-6 max-w-[48ch]">
          <h3 class="text-lg font-medium">Sandboxed workspaces</h3>
          <p class="mt-2 text-muted-foreground">
            Turn the sandbox on and a workspace's shells are confined to its folder and a list of allowed hosts.
            Anything else asks you first.
          </p>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="wrap py-20 md:py-28" aria-labelledby="review">
    <div class="grid items-center gap-x-16 gap-y-12 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]">
      <figure class="stage reveal max-lg:order-last">
        <Shot
          name="changes"
          sizes="(min-width: 1024px) 600px, calc(100vw - 4rem)"
          alt="The Git panel on the branch feat/idempotency-keys with two changed files and two untracked files, next to the diff of invoices.ts."
        />
      </figure>
      <div>
        <h2 id="review" class="title">Read the change before it lands</h2>
        <p class="lede mt-4 max-w-[44ch]">
          The built-in Git extension lists what changed and opens any file as a diff. Agents can stage and commit
          with <code>pine git</code>. Discarding changes is yours alone, after a confirm.
        </p>
      </div>
    </div>
  </section>

  <section class="wrap py-20 md:py-28" aria-labelledby="customize">
    <h2 id="customize" class="title">Shape it to how you work</h2>
    <div class="mt-10 grid grid-cols-1 gap-5 *:min-w-0 lg:grid-cols-12">
      <article class="rounded-2xl bg-card p-6 md:p-8 lg:col-span-7">
        <h3 class="text-lg font-medium">Sidebar sections from a JSON file</h3>
        <p class="mt-2 max-w-[52ch] text-muted-foreground">
          A view is one data file that Pine draws with its own components. An agent can write one, and it appears
          once you switch it on.
        </p>
        <div class="reveal mt-7 grid items-end gap-4 sm:grid-cols-[438fr_292fr]">
          <Shot
            name="view-json"
            sizes="(min-width: 1024px) 370px, (min-width: 640px) 56vw, calc(100vw - 5.5rem)"
            alt="agents.json in the editor: a sidebar view that lists every workspace with its state."
          />
          <Shot
            name="view-rail"
            class="max-sm:max-w-[292px]"
            sizes="(min-width: 1024px) 250px, (min-width: 640px) 36vw, 292px"
            alt="The section that file produces in the sidebar: each workspace with waiting, done, working, error or idle beside it, and a button for a new scratch workspace."
          />
        </div>
      </article>
      <article class="rounded-2xl bg-card p-6 md:p-8 lg:col-span-5">
        <h3 class="text-lg font-medium">Extensions from any git repository</h3>
        <p class="mt-2 text-muted-foreground">
          An extension is a manifest and an optional program in any language. Add a marketplace repository, install
          what you want and approve it before it runs.
        </p>
        <pre class="codeblock mt-6 !bg-background" tabindex="0" aria-label="Example pine.json manifest"><code>{`{
  "id": "weather",
  "name": "Weather",
  "api": "1.1",
  "capabilities": ["notify"],
  "contributes": { "paneChips": true }
}`}</code></pre>
        <p class="mt-6">
          <a class="link inline-flex items-center gap-1.5" href={SDK_URL} rel="noopener">
            Extension SDK <Icon name="arrow-up-right" size={15} />
          </a>
        </p>
      </article>
      <article class="grid items-center gap-x-10 gap-y-7 rounded-2xl bg-card p-6 md:p-8 lg:col-span-12 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)]">
        <div>
          <h3 class="text-lg font-medium">Themes, prompt and keys</h3>
          <p class="mt-2 max-w-[40ch] text-muted-foreground">
            Pick a theme, then give the terminal or the editor its own colour scheme. Arrange the chips in your
            prompt and set your own chords.
          </p>
        </div>
        <div class="pan reveal">
          <Shot
            name="themes"
            class="max-md:min-w-[36rem]"
            sizes="(min-width: 1024px) 740px, calc(100vw - 5.5rem)"
            alt="Appearance settings: the Oxocarbon theme, separate terminal and editor colour schemes with a live preview, and accent colour choices."
          />
        </div>
      </article>
    </div>
  </section>

  <section class="wrap py-20 md:py-28" aria-labelledby="also">
    <h2 id="also" class="title">Also built in</h2>
    <dl class="mt-10 grid gap-x-12 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {
        also.map((item) => (
          <div>
            <dt class="font-medium">{item.title}</dt>
            <dd class="mt-2 max-w-[42ch] text-muted-foreground">{item.body}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="wrap pb-24 md:pb-32" aria-labelledby="get">
    <div class="grid items-center gap-x-12 gap-y-8 rounded-2xl bg-card p-7 md:p-12 lg:grid-cols-[minmax(0,1fr)_auto]">
      <div>
        <h2 id="get" class="title">Pine runs on Linux today</h2>
        <p class="lede mt-3 max-w-[52ch]">
          {
            release
              ? `Version ${release.version}, published ${formatDate(release.publishedAt)}, for x64 as an AppImage or a tarball.`
              : 'For x64, as an AppImage or a tarball.'
          }
        </p>
        <pre class="codeblock mt-6 !bg-background max-w-xl" tabindex="0" aria-label="Commands to run the AppImage"><code>chmod +x {appImage}
./{appImage}</code></pre>
      </div>
      <a class={buttonVariants({ size: 'xl' })} href={href('download/')}><Icon name="download" /> Download</a>
    </div>
  </section>
</Base>
