---
import Icon from '../components/Icon.astro'
import { Input } from '../components/ui/input'
import { NativeSelect, NativeSelectOption } from '../components/ui/native-select'
import Base from '../layouts/Base.astro'
import { formatDate } from '../lib/release'
import { EXTENSION_GUIDE_URL, MARKETPLACE_REPO, MARKETPLACE_REPO_URL } from '../lib/site'
import { snapshotView, snapshotViewDate } from '../lib/snapshot'
import { extensionList } from '../lib/views'

const view = snapshotView
const embedded = JSON.stringify(view).replace(/</g, '\\u003c')
---

<Base
  title="Pine extensions"
  description="Extensions in the public Pine marketplace, read from the repository: what each one asks for, what it adds, and how to install it."
  current="extensions"
>
  <section class="wrap pb-10 pt-12 md:pt-16" aria-labelledby="title">
    <h1 id="title" class="display">Extensions</h1>
    <p class="lede mt-5 max-w-[60ch]">
      This page reads the public marketplace repository,{' '}
      <a class="link" href={MARKETPLACE_REPO_URL} rel="noopener">{MARKETPLACE_REPO}</a>, and shows what each
      extension asks for and what it adds to Pine.
    </p>
  </section>

  <section class="wrap pb-16" aria-labelledby="list-title">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,8fr)_minmax(0,4fr)] lg:gap-14">
      <div>
        <h2 id="list-title" class="sr-only">Extensions in the marketplace</h2>
        <form id="filters" class="mb-6 grid gap-4 sm:grid-cols-[minmax(0,1fr)_14rem]" hidden role="search">
          <div class="grid gap-2">
            <label for="search" class="text-sm font-medium">Search extensions</label>
            <Input id="search" name="search" type="search" className="h-10" autoComplete="off" spellCheck={false} />
          </div>
          <div class="grid gap-2">
            <label for="category" class="text-sm font-medium">Category</label>
            <NativeSelect id="category" name="category" className="w-full [&_select]:h-10">
              <NativeSelectOption value="">All categories</NativeSelectOption>
            </NativeSelect>
          </div>
        </form>
        <div id="extensions" class="grid gap-5">
          {
            view ? (
              <Fragment set:html={extensionList(view.entries).value} />
            ) : (
              <p class="text-muted-foreground">
                The list could not be saved when this page was built. It is in the{' '}
                <a class="link" href={MARKETPLACE_REPO_URL} rel="noopener">marketplace repository</a>.
              </p>
            )
          }
        </div>
        <p id="extensions-status" class="mt-5 text-sm text-muted-foreground" role="status">
          {view ? `List saved on ${formatDate(snapshotViewDate)}, when this page was built.` : ''}
        </p>
      </div>

      <aside aria-labelledby="install-title">
        <h2 id="install-title" class="text-lg font-medium">Install one in Pine</h2>
        <ol class="prose-list mt-3 list-decimal pl-5 leading-relaxed text-muted-foreground">
          <li>Open Settings, then Extensions.</li>
          <li>Under Marketplaces, type <code class="text-foreground">{MARKETPLACE_REPO}</code> and choose Add.</li>
          <li>Choose Install on an extension. It runs only after you approve it.</li>
        </ol>
        <p class="mt-4 leading-relaxed text-muted-foreground">
          Installing copies the extension's folder to your machine. Pine never runs a build or a script from a
          marketplace.
        </p>
      </aside>
    </div>
  </section>

  <section class="border-t bg-card py-16" aria-labelledby="publish">
    <div class="wrap grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-14">
      <div>
        <h2 id="publish" class="title">Publish your own marketplace</h2>
        <p class="mt-3 max-w-[52ch] leading-relaxed text-muted-foreground">
          A marketplace is a git repository with a <code>pine-marketplace.json</code> at its root. Each listed
          folder holds one extension with its own <code>pine.json</code> and its built files, committed.
          Anyone adds it by <code>owner/repo</code>, a git URL or a folder path.
        </p>
        <p class="mt-4">
          <a class="link inline-flex items-center gap-1" href={EXTENSION_GUIDE_URL} rel="noopener">
            Extension guide <Icon name="arrow-up-right" size={14} />
          </a>
        </p>
      </div>
      <pre class="codeblock !bg-background self-start" tabindex="0" aria-label="Example pine-marketplace.json"><code>{`{
  "name": "Acme extensions",
  "description": "Tools from Acme",
  "extensions": ["extensions/weather", "extensions/timer"]
}`}</code></pre>
    </div>
  </section>
</Base>

<script type="application/json" id="marketplace-snapshot" set:html={embedded} />
<script>
  import '../client/extensions.ts'
</script>
