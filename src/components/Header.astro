---
import iconUrl from '../assets/icon.svg?url'
import { buttonVariants } from '../components/ui/button'
import { href } from '../lib/paths'
import { APP_REPO_URL } from '../lib/site'
import Icon from './Icon.astro'

interface Props {
  current: 'home' | 'download'
}

const { current } = Astro.props
---

<header class="site-header sticky top-0 z-10">
  <div class="wrap flex h-16 items-center justify-between gap-6">
    <a href={href('')} class="flex items-center gap-2.5 text-[1.0625rem] font-semibold tracking-tight" aria-label="Pine home">
      <img src={iconUrl} alt="" width="26" height="26" class="rounded-md" />
      Pine
    </a>
    <nav aria-label="Main" class="flex items-center gap-1 text-[0.9375rem]">
      <a
        href={APP_REPO_URL}
        rel="noopener"
        class="flex items-center gap-1.5 rounded-lg px-3 py-2 text-muted-foreground transition-colors hover:text-foreground"
      >
        <Icon name="github" />
        <span class="max-sm:sr-only">GitHub</span>
      </a>
      <a
        href={href('download/')}
        aria-current={current === 'download' ? 'page' : undefined}
        class:list={[buttonVariants({ size: 'lg' }), 'ml-2 px-3.5']}
      >
        Download
      </a>
    </nav>
  </div>
</header>
