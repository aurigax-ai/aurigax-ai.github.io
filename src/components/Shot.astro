---
import { shotSources } from '../lib/shots'

interface Props {
  name: string
  alt: string
  sizes: string
  eager?: boolean
  class?: string
}

const { name, alt, sizes, eager = false, class: className = '' } = Astro.props
const image = await shotSources(name)
---

<img
  class:list={['shot', className]}
  src={image.src}
  srcset={image.srcset}
  sizes={sizes}
  width={image.width}
  height={image.height}
  alt={alt}
  loading={eager ? 'eager' : 'lazy'}
  decoding={eager ? 'sync' : 'async'}
  fetchpriority={eager ? 'high' : undefined}
/>
