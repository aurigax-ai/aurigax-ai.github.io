{
  "pine-marketplace.json": {
    "name": "Fixture marketplace",
    "extensions": ["extensions/weather", "extensions/broken", "extensions/theme-pack", "extensions/missing"]
  },
  "extensions/weather/pine.json": {
    "id": "weather",
    "name": "Weather <script>window.__pwned = true</script>",
    "version": "2.0.0",
    "api": "1.1",
    "description": "Forecast chips for <b>every</b> pane",
    "category": "tools",
    "capabilities": ["notify"],
    "main": "main.js",
    "contributes": {
      "commands": [{ "id": "show", "title": "Weather: Show Forecast" }],
      "paneChips": [{ "id": "now", "title": "Current weather" }],
      "holoDecks": [{ "label": "Bridge" }]
    }
  },
  "extensions/broken/pine.json": { "name": "No id here" },
  "extensions/theme-pack/pine.json": {
    "id": "theme-pack",
    "name": "Theme pack",
    "version": "0.4.0",
    "description": "Two file icon themes",
    "category": "themes",
    "contributes": { "iconThemes": [{ "id": "a", "label": "Aurora" }, { "id": "b", "label": "Basalt" }] }
  }
}
