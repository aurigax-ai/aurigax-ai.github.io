{
  "name": "pine-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "astro dev",
    "snapshot": "node scripts/snapshot.mjs",
